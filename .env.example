# Copie este archivo como ".env" y ponga sus datos de conexión.
# El archivo .env no se sube a GitHub (está en .gitignore).

# Conexión a MySQL Server (los mismos datos que usa en MySQL Workbench)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=su_contraseña_de_mysql
MYSQL_DATABASE=comite_db

# Clave para firmar la sesión de Flask: use un texto largo y aleatorio.
# Puede generarla con:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambie-esta-clave

# Carpeta donde se guardan los documentos cargados (opcional)
# COMITE_UPLOAD_DIR=uploads

# --- Despliegue en la nube (Vercel + MySQL en la nube, p. ej. Aiven) ---
# En Vercel estas variables se configuran en Project Settings > Environment Variables.
# MYSQL_SSL_CA=ruta/al/ca.pem   (opcional: verificar el certificado SSL del servidor)
# MYSQL_POOL_SIZE=2             (en Vercel ya es 2 por defecto)
